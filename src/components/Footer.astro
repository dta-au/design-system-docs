---
// Footer slots are intentionally empty placeholders, mirroring the Jekyll
// source where {{ FOOTER_*_* }} variables were never populated.
---

<footer class="ct-footer ct-theme-light" role="contentinfo" data-component-name="ct-footer">
  <div class="container ct-footer__top">
    <div class="row">
      <div class="col-xxs-12 col-m-6">
        <div class="ct-footer__top__content-top1"></div>
      </div>
      <div class="col-xxs-12 col-m-6">
        <div class="ct-footer__top__content-top2"></div>
      </div>
    </div>
  </div>

  <div class="container ct-footer__middle">
    <div class="row">
      <div class="col-xxs-12 col-m-3">
        <div class="ct-footer__middle__content-middle1"></div>
      </div>
      <div class="col-xxs-12 col-m-3">
        <div class="ct-footer__middle__content-middle2"></div>
      </div>
      <div class="col-xxs-12 col-m-3">
        <div class="ct-footer__middle__content-middle3"></div>
      </div>
      <div class="col-xxs-12 col-m-3">
        <div class="ct-footer__middle__content-middle4"></div>
      </div>
    </div>
  </div>

  <div class="container ct-footer__bottom">
    <div class="row">
      <div class="col-xxs-12 col-m-7">
        <div class="ct-footer__bottom__content-bottom1"></div>
      </div>
      <div class="col-xxs-12 col-m-5">
        <div class="ct-footer__bottom__content-bottom2"></div>
      </div>
    </div>
  </div>
</footer>
