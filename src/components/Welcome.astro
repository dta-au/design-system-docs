---
import { mainnav } from '../data/navs';

const baseTrim = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (url: string) => (url.startsWith('/') ? `${baseTrim}${url}` : url);
---

<div class="ct-basic-content ct-theme-light ct-vertical-spacing--top">
  <div class="container">
    <div class="row">
      <div class="col-l-8">
        <h1 class="ct-heading ct-theme-light ct-banner__title">Design library</h1>
        <p>Foundations, components, patterns and templates for publishing on digital.gov.au. Follow this guidance to plan, write and build pages that look and behave consistently.</p>
      </div>
    </div>
  </div>
</div>

<div class="ct-list ct-theme-light ct-vertical-spacing-inset--top">
  <div class="ct-list__inner">
    <div class="ct-list__rows ct-vertical-spacing-inset--bottom">
      <div class="container" aria-live="polite">
        <div class="row row--equal-heights-content row--vertically-spaced">
          {mainnav.map((section) => (
            <div class="col-xxs-12 col-m-4">
              <div class="ct-navigation-card ct-theme-light ct-navigation-card--with-link ct-navigation-card--card-clickable">
                <div class="ct-navigation-card__content">
                  <div class="ct-navigation-card__title">
                    <h2 class="ct-navigation-card__title">
                      <a class="ct-navigation-card__title-link" href={withBase(section.url)}>
                        {section.title}
                      </a>
                    </h2>
                  </div>
                  {section.description && (
                    <div class="ct-paragraph ct-theme-light ct-paragraph--regular ct-paragraph--no-margin ct-navigation-card__summary">
                      {section.description}
                    </div>
                  )}
                  <div class="ct-navigation-card__tags">
                    <div class="ct-navigation-card__link-graphic">
                      <svg class="ct-icon ct-icon--size-regular" aria-hidden="true" role="img" width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M17.92 11.62C17.8724 11.4973 17.801 11.3851 17.71 11.29L12.71 6.29C12.6168 6.19676 12.5061 6.1228 12.3842 6.07234C12.2624 6.02188 12.1319 5.99591 12 5.99591C11.7337 5.99591 11.4783 6.1017 11.29 6.29C11.1968 6.38324 11.1228 6.49393 11.0723 6.61575C11.0219 6.73758 10.9959 6.86814 10.9959 7C10.9959 7.2663 11.1017 7.5217 11.29 7.71L14.59 11H7C6.73478 11 6.48043 11.1054 6.29289 11.2929C6.10536 11.4804 6 11.7348 6 12C6 12.2652 6.10536 12.5196 6.29289 12.7071C6.48043 12.8946 6.73478 13 7 13H14.59L11.29 16.29C11.1963 16.383 11.1219 16.4936 11.0711 16.6154C11.0203 16.7373 10.9942 16.868 10.9942 17C10.9942 17.132 11.0203 17.2627 11.0711 17.3846C11.1219 17.5064 11.1963 17.617 11.29 17.71C11.383 17.8037 11.4936 17.8781 11.6154 17.9289C11.7373 17.9797 11.868 18.0058 12 18.0058C12.132 18.0058 12.2627 17.9797 12.3846 17.9289C12.5064 17.8781 12.617 17.8037 12.71 17.71L17.71 12.71C17.801 12.6149 17.8724 12.5028 17.92 12.38C18.02 12.1365 18.02 11.8635 17.92 11.62Z"></path>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
