---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Content from '../layouts/Content.astro';
import Demo from '../components/Demo.astro';

type AnyEntry =
  | CollectionEntry<'foundations'>
  | CollectionEntry<'components'>
  | CollectionEntry<'components-advanced'>
  | CollectionEntry<'patterns'>
  | CollectionEntry<'templates'>;

export async function getStaticPaths() {
  const collections = [
    'foundations',
    'components',
    'components-advanced',
    'patterns',
    'templates',
  ] as const;

  const entries = (
    await Promise.all(collections.map((c) => getCollection(c)))
  ).flat();

  return entries
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: `${entry.collection}/${entry.id}` },
      props: { entry },
    }));
}

interface Props {
  entry: AnyEntry;
}

const { entry } = Astro.props;
const { Content: EntryContent } = await render(entry);

// Synced component docs carry no demo markup; the demo association is a
// dga-dl convention – render the demo iframe when a matching file exists.
const demos = import.meta.glob('../assets/demos/*.html');
const hasDemo =
  (entry.collection === 'components' || entry.collection === 'components-advanced') &&
  `../assets/demos/${entry.id}.html` in demos;

// The "On this page" ToC is frontmatter-driven: any synced doc can opt in
// with `toc: true` (or a foundations page out with `toc: false`) – the
// sidebar-less foundations collection defaults to true. The treatment pairs
// with the full-width layout.
const toc = entry.data.toc ?? entry.collection === 'foundations';
const fullWidth = entry.collection === 'foundations' || toc;
const tocMaxLevel = entry.data['toc-max-level'] ?? 4;
---

<Content
  title={entry.data.title}
  description={entry.data.description}
  fullWidth={fullWidth}
  toc={toc}
  tocMaxLevel={tocMaxLevel}
>
  {hasDemo && <Demo name={entry.id} />}
  <EntryContent />
</Content>
